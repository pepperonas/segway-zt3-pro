      "type": "read",
      "cmd": 1,
      "response_cmd": 4,
      "arg": "offset",
      "payload_args": [
        "length"
      ],
      "format": "read_register",
      "retries": null,
      "timeout": null
    },
    "write_register": {
      "type": "write",
      "cmd": 2,
      "response_cmd": 5,
      "arg": "offset",
      "payload_args": [
        "data"
      ],
      "format": "write_register",
      "retries": null,
      "timeout": null
    },
    "write_no_reply": {
      "type": "write_no_reply",
      "cmd": 3,
      "response_cmd": null,
      "arg": "offset",
